<control> default_path=Pizzicato\
<group> group=1 seq_length=2 lovel=81 ampeg_sustain=.01 ampeg_decay=18
<region> sample=1_C_4a.flac pitch_keycenter=c1 hikey=c#1
<region> sample=1_C_4b.flac pitch_keycenter=c1 hikey=c#1 seq_position=2
<region> sample=1_Eb_4a.flac pitch_keycenter=d#1 lokey=d1 hikey=e1
<region> sample=1_Eb_4b.flac pitch_keycenter=d#1 lokey=d1 hikey=e1 seq_position=2
<region> sample=1_Gb_4a.flac pitch_keycenter=f#1 lokey=f1 hikey=g1
<region> sample=1_Gb_4b.flac pitch_keycenter=f#1 lokey=f1 hikey=g1 seq_position=2
<region> sample=1_A_4a.flac pitch_keycenter=a1 lokey=g#1 hikey=a#1
<region> sample=1_A_4b.flac pitch_keycenter=a1 lokey=g#1 hikey=a#1 seq_position=2
<region> sample=2_C_4a.flac pitch_keycenter=c2 lokey=b1 hikey=c#2
<region> sample=2_C_4b.flac pitch_keycenter=c2 lokey=b1 hikey=c#2 seq_position=2
<region> sample=2_Eb_4a.flac pitch_keycenter=d#2 lokey=d2 hikey=e2
<region> sample=2_Eb_4b.flac pitch_keycenter=d#2 lokey=d2 hikey=e2 seq_position=2
<region> sample=2_Gb_4a.flac pitch_keycenter=f#2 lokey=f2 hikey=g2
<region> sample=2_Gb_4b.flac pitch_keycenter=f#2 lokey=f2 hikey=g2 seq_position=2
<region> sample=2_A_4a.flac pitch_keycenter=a2 lokey=g#2 hikey=a#2
<region> sample=2_A_4b.flac pitch_keycenter=a2 lokey=g#2 hikey=a#2 seq_position=2
<region> sample=3_C_4a.flac pitch_keycenter=c3 lokey=b2 hikey=c#3
<region> sample=3_C_4b.flac pitch_keycenter=c3 lokey=b2 hikey=c#3 seq_position=2
<region> sample=3_Eb_4a.flac pitch_keycenter=d#3 lokey=d3 hikey=e3
<region> sample=3_Eb_4b.flac pitch_keycenter=d#3 lokey=d3 hikey=e3 seq_position=2
<region> sample=3_Gb_4a.flac pitch_keycenter=f#3 lokey=f3 hikey=g3
<region> sample=3_Gb_4b.flac pitch_keycenter=f#3 lokey=f3 hikey=g3 seq_position=2
<region> sample=3_A_4a.flac pitch_keycenter=a3 lokey=g#3 hikey=a#3
<region> sample=3_A_4b.flac pitch_keycenter=a3 lokey=g#3 hikey=a#3 seq_position=2
<region> sample=4_C_4a.flac pitch_keycenter=c4 lokey=b3
<region> sample=4_C_4b.flac pitch_keycenter=c4 lokey=b3 seq_position=2

<group> group=2 seq_length=2 lovel=40 hivel=80 ampeg_sustain=.01 ampeg_decay=18
<region> sample=1_C_3a.flac pitch_keycenter=c1 hikey=c#1
<region> sample=1_C_3b.flac pitch_keycenter=c1 hikey=c#1 seq_position=2
<region> sample=1_Eb_3a.flac pitch_keycenter=d#1 lokey=d1 hikey=e1
<region> sample=1_Eb_3b.flac pitch_keycenter=d#1 lokey=d1 hikey=e1 seq_position=2
<region> sample=1_Gb_3a.flac pitch_keycenter=f#1 lokey=f1 hikey=g1
<region> sample=1_Gb_3b.flac pitch_keycenter=f#1 lokey=f1 hikey=g1 seq_position=2
<region> sample=1_A_3a.flac pitch_keycenter=a1 lokey=g#1 hikey=a#1
<region> sample=1_A_3b.flac pitch_keycenter=a1 lokey=g#1 hikey=a#1 seq_position=2
<region> sample=2_C_3a.flac pitch_keycenter=c2 lokey=b1 hikey=c#2
<region> sample=2_C_3b.flac pitch_keycenter=c2 lokey=b1 hikey=c#2 seq_position=2
<region> sample=2_Eb_3a.flac pitch_keycenter=d#2 lokey=d2 hikey=e2
<region> sample=2_Eb_3b.flac pitch_keycenter=d#2 lokey=d2 hikey=e2 seq_position=2
<region> sample=2_Gb_3a.flac pitch_keycenter=f#2 lokey=f2 hikey=g2
<region> sample=2_Gb_3b.flac pitch_keycenter=f#2 lokey=f2 hikey=g2 seq_position=2
<region> sample=2_A_3a.flac pitch_keycenter=a2 lokey=g#2 hikey=a#2
<region> sample=2_A_3b.flac pitch_keycenter=a2 lokey=g#2 hikey=a#2 seq_position=2
<region> sample=3_C_3a.flac pitch_keycenter=c3 lokey=b2 hikey=c#3
<region> sample=3_C_3b.flac pitch_keycenter=c3 lokey=b2 hikey=c#3 seq_position=2
<region> sample=3_Eb_3a.flac pitch_keycenter=d#3 lokey=d3 hikey=e3
<region> sample=3_Eb_3b.flac pitch_keycenter=d#3 lokey=d3 hikey=e3 seq_position=2
<region> sample=3_Gb_3a.flac pitch_keycenter=f#3 lokey=f3 hikey=g3
<region> sample=3_Gb_3b.flac pitch_keycenter=f#3 lokey=f3 hikey=g3 seq_position=2
<region> sample=3_A_3a.flac pitch_keycenter=a3 lokey=g#3 hikey=a#3
<region> sample=3_A_3b.flac pitch_keycenter=a3 lokey=g#3 hikey=a#3 seq_position=2
<region> sample=4_C_3a.flac pitch_keycenter=c4 lokey=b3
<region> sample=4_C_3b.flac pitch_keycenter=c4 lokey=b3 seq_position=2

<group> group=4 hivel=39 ampeg_sustain=.01 ampeg_decay=18
<region> sample=1_C_p.flac pitch_keycenter=c1 hikey=c#1
<region> sample=1_Eb_p.flac pitch_keycenter=d#1 lokey=d1 hikey=e1
<region> sample=1_Gb_p.flac pitch_keycenter=f#1 lokey=f1 hikey=g1
<region> sample=1_A_p.flac pitch_keycenter=a1 lokey=g#1 hikey=a#1
<region> sample=2_C_p.flac pitch_keycenter=c2 lokey=b1 hikey=c#2
<region> sample=2_Eb_p.flac pitch_keycenter=d#2 lokey=d2 hikey=e2
<region> sample=2_Gb_p.flac pitch_keycenter=f#2 lokey=f2 hikey=g2
<region> sample=2_A_p.flac pitch_keycenter=a2 lokey=g#2 hikey=a#2
<region> sample=3_C_p.flac pitch_keycenter=c3 lokey=b2 hikey=c#3
<region> sample=3_Eb_p.flac pitch_keycenter=d#3 lokey=d3 hikey=e3
<region> sample=3_Gb_p.flac pitch_keycenter=f#3 lokey=f3 hikey=g3
<region> sample=3_A_p.flac pitch_keycenter=a3 lokey=g#3 hikey=a#3
<region> sample=4_C_p.flac pitch_keycenter=c4 lokey=b3

<group> group=3 trigger=release loop_mode=one_shot
<region> sample=_Gb1.flac hikey=f#1 pitch_keycenter=f#1
<region> sample=_G1.flac key=g1
<region> sample=_Ab1.flac key=g#1
<region> sample=_A1.flac key=a1
<region> sample=_Bb1.flac key=a#1
<region> sample=_B1.flac key=b1
