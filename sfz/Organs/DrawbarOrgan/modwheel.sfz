// Cheezy Hammond Drawbar Sim
// Control drawbars by Mod wheel

// Mod Wheel -> Registration
//
// blues
//   0 -   9  - 8880-00-000
//  10 -  19  - 8880-02-000
//  20 -  29  - 8888-00-000
//  30 -  39  - 8888-02-000
//
// flutes
//  40 -  49  - 8080-00-000
//  50 -  59  - 8080-02-000
//  60 -  69  - 8008-00-000
//  70 -  79  - 8008-02-000
//  80 -  89  - 8000-08-000
//
// swing
//  90 -  99  - 8400-12-340
// 100 - 109  - 8640-01-234
//
// full
// 110 - 127  - 8888-88-888

<control>
label_cc1=drawbar selection
label_cc11=Swell Pedal
set_cc1=0
set_cc11=70

<global> amp_veltrack=0 global_volume=-32 gain_cc11=24 loop_mode=loop_continuous lokey=35
sustain_sw=off // disable sustain pedal, as it might be used to control rotor speed

// blues
<region>sample=8880-00-000.wav locc1=000 hicc1=009
<region>sample=8880-02-000.wav locc1=010 hicc1=019
<region>sample=8888-00-000.wav locc1=020 hicc1=029
<region>sample=8888-02-000.wav locc1=030 hicc1=039

// flutes
<region>sample=8080-00-000.wav locc1=040 hicc1=049
<region>sample=8080-02-000.wav locc1=050 hicc1=059
<region>sample=8008-00-000.wav locc1=060 hicc1=069
<region>sample=8008-02-000.wav locc1=070 hicc1=079
<region>sample=8000-08-000.wav locc1=080 hicc1=089

// swing
<region>sample=8400-12-340.wav locc1=090 hicc1=099
<region>sample=8640-01-234.wav locc1=100 hicc1=109

// full
<region>sample=8888-88-888.wav locc1=110 hicc1=127
