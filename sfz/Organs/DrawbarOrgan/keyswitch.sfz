// Cheezy Hammond Drawbar Sim
// Control drawbars by keyswitch

// Keyswitch Registrations
//
// blues
// A0  - 8880-00-000
// A#0 - 8880-02-000
// B0  - 8888-00-000
// C1  - 8888-02-000
//
// flutes
// C#1 - 8080-00-000
// D1  - 8080-02-000
// D#1 - 8008-00-000
// E1  - 8008-02-000
// F1  - 8000-08-000
//
// swing
// F#1 - 8400-12-340
// G1  - 8640-01-234
//
// full
// G#1 - 8888-88-888


<control>
label_cc11=Swell Pedal
set_cc11=70

<global> amp_veltrack=0 global_volume=-32 gain_cc11=24 loop_mode=loop_continuous lokey=35
sustain_sw=off // disable sustain pedal, as it might be used to control rotor speed
sw_lokey=21
sw_hikey=32
sw_default=21

// blues
<region>sample=8880-00-000.wav sw_last=21
<region>sample=8880-02-000.wav sw_last=22
<region>sample=8888-00-000.wav sw_last=23
<region>sample=8888-02-000.wav sw_last=24

// flutes
<region>sample=8080-00-000.wav sw_last=25
<region>sample=8080-02-000.wav sw_last=26
<region>sample=8008-00-000.wav sw_last=27
<region>sample=8008-02-000.wav sw_last=28
<region>sample=8000-08-000.wav sw_last=29

// swing
<region>sample=8400-12-340.wav sw_last=30
<region>sample=8640-01-234.wav sw_last=31

// full
<region>sample=8888-88-888.wav sw_last=32


