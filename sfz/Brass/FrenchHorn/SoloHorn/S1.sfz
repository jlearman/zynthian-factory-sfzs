<control> default_path=Sustain\
<region> sample=2_C.flac pitch_keycenter=c2 hikey=c#2
<region> sample=2_Eb.flac pitch_keycenter=d#2 lokey=d2 hikey=e2
<region> sample=2_G.flac pitch_keycenter=g2 lokey=f2 hikey=g#2
<region> sample=2_B.flac pitch_keycenter=b2 lokey=a2 hikey=b2
<region> sample=3_Db.flac pitch_keycenter=c#3 lokey=c3 hikey=d#3
<region> sample=3_F.flac pitch_keycenter=f3 lokey=e3 hikey=f3
<region> sample=3_Ab.flac pitch_keycenter=g#3 lokey=f#3 hikey=a3
<region> sample=4_C.flac pitch_keycenter=c4 lokey=a#3 hikey=c4
<region> sample=4_Db.flac pitch_keycenter=c#4 lokey=c#4 hikey=d#4
<region> sample=4_F.flac pitch_keycenter=f4 lokey=e4 hikey=f4
<region> sample=4_Ab.flac pitch_keycenter=g#4 lokey=f#4 hikey=a4
<region> sample=5_C.flac pitch_keycenter=c5 lokey=a#4 hikey=c#5
<region> sample=5_E.flac pitch_keycenter=e5 lokey=d5